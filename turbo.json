{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-dev/**"]
    },
    "build:deps": {
      "dependsOn": ["^build:deps"],
      "outputs": ["dist/**", "dist-dev/**"]
    },
    "typecheck": {
      "dependsOn": ["build:deps", "^typecheck"]
    },
    "//#typecheck:root": {},
    "dev": {
      "dependsOn": ["build:deps", "^build:deps"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build:deps"]
    }
  }
}
